module {
  func.func @cst() -> i64 {
    %0 = ocaml.constant 42
    return %0 : i64
  }
  func.func @arith(%arg0: i64, %arg1: i64) -> i64 {
    %0 = ocaml.addi %arg0, %arg1 : i64
    %1 = ocaml.subi %0, %arg1 : i64
    %2 = ocaml.muli %1, %arg1 : i64
    %3 = ocaml.divi %2, %arg1 : i64
    %4 = ocaml.modi %3, %arg1 : i64
    return %4 : i64
  }
  func.func @cmp(%arg0: i64, %arg1: i64) -> i1 {
    %0 = ocaml.cmpi eq, %arg0, %arg1 : i64
    %1 = ocaml.cmpi ne, %arg0, %arg1 : i64
    %2 = ocaml.cmpi slt, %arg0, %arg1 : i64
    %3 = ocaml.cmpi sle, %arg0, %arg1 : i64
    %4 = ocaml.cmpi sgt, %arg0, %arg1 : i64
    %5 = ocaml.cmpi sge, %arg0, %arg1 : i64
    return %0 : i1
  }
}

